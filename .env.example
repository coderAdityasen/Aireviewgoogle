NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy compatibility names are still accepted:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- AI for review drafts (priority: Gemini → OpenRouter → AI_PROVIDER_*) ---
# Recommended: Google AI Studio key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional fallback: OpenRouter (ignored when GEMINI_API_KEY is set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
OPENROUTER_DATA_COLLECTION=deny

IP_HASH_SECRET=
ADMIN_EMAIL_ALLOWLIST=

PAYMENT_PROVIDER=razorpay
# Key ID (public) + Key Secret (server only) for one-time Orders checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Growth uses Razorpay Orders (one-time), not subscription plan IDs.
# Legacy plan ID env vars are unused and can be removed.
BILLING_MOCK_MODE=false

# Optional Google Places support; not required for the MVP.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional compatibility fallback for other OpenAI-compatible providers
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1/chat/completions
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=10
